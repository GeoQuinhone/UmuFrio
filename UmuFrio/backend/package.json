{
  "name": "umufrio-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "node src/db/migrate.js",
    "db:push": "drizzle-kit push --config=drizzle.config.cjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.cjs",
    "check": "node --check src/app.js && node --check src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1"
  }
}
