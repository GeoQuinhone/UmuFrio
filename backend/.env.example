DATABASE_URL=postgresql://USUARIO:01020304@localhost:5432/umufrio_db
SESSION_SECRET=troque-por-uma-chave-local-com-pelo-menos-32-caracteres
PORT=3001

# Copie este arquivo para .env e ajuste usuário, senha e banco conforme
# a instalação local do PostgreSQL.

# Opcional: se "true", só é possível concluir o atendimento com o pagamento confirmado.
# Por padrão (false) a tela apenas avisa que o pagamento está pendente.
EXIGIR_PAGAMENTO_PARA_CONCLUIR=false

# Produção: endereço(s) do frontend autorizados a chamar a API, separados por
# vírgula (ex.: https://umufrio.pages.dev). Deixe vazio no ambiente local.
CORS_ORIGIN=

# Opcional: aviso automático ao cliente pelo WhatsApp (Cloud API da Meta) quando
# o atendimento é iniciado ou concluído. Sem token e ID do número, a tela
# oferece o botão "Enviar pelo WhatsApp" (link wa.me) no lugar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_INICIADO=servico_iniciado
WHATSAPP_TEMPLATE_CONCLUIDO=servico_concluido
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
EMPRESA_NOME=UmuFrio

# Em produção (Render), estas variáveis são preenchidas no painel do serviço,
# não neste arquivo. Veja DEPLOY.md na raiz do projeto.

# ---------------------------------------------------------------------------
# Fase 4 — PIX / Mercado Pago (tudo opcional)
# ---------------------------------------------------------------------------
# Sem MP_ACCESS_TOKEN o sistema funciona em MODO SIMULADO: gera um código PIX
# fictício e a tela mostra um botão para "simular o pagamento" (ótimo para a
# apresentação). Com o token, as cobranças são criadas de verdade no Mercado
# Pago. Para desenvolver use o token de TESTE (começa com TEST-), em
# https://www.mercadopago.com.br/developers/panel -> Credenciais de teste.
# MP_ACCESS_TOKEN=
#
# Força o modo simulado mesmo com o token preenchido.
# PIX_MODO=simulado
#
# Aviso automático (webhook) — precisa de uma URL pública https (ex.: ngrok).
# No localhost não é necessário: a tela consulta o Mercado Pago a cada poucos
# segundos e confirma o pagamento sozinha.
# MP_NOTIFICATION_URL=https://seu-endereco-publico/api/pix/webhook
# MP_WEBHOOK_SECRET=
#
# E-mail enviado ao Mercado Pago (o cadastro de clientes não tem e-mail).
# MP_PAYER_EMAIL_PADRAO=cliente@umufrio.com.br
#
# Validade do PIX em minutos (5 a 1440).
# PIX_EXPIRACAO_MINUTOS=30

# Fuso usado nos relatórios para decidir em que dia cai cada pagamento.
# RELATORIOS_FUSO=America/Sao_Paulo

# ---- Fase 5: check-in geolocalizado e chat de atendimento (todas opcionais) ----
# Raio (em metros) entre o técnico e o endereço do cliente para o check-in/check-out
# valer sem justificativa. Padrão: 150. Fora do raio, o técnico precisa justificar.
# CHECKIN_RAIO_METROS=150
# O endereço do cliente vira coordenadas pelo Nominatim (OpenStreetMap), gratuito.
# Informe um e-mail de contato (boa prática exigida pelo serviço).
# GEOCODING_EMAIL=seu-email@exemplo.com
# NOMINATIM_URL=https://nominatim.openstreetmap.org
#
# Chat de atendimento da tela inicial (IA de verdade).
# Opção gratuita: Groq (console.groq.com -> API Keys). Se existir GROQ_API_KEY, ela é usada.
# GROQ_API_KEY=gsk_...
# CHAT_MODELO=llama-3.3-70b-versatile
# Opção paga: Anthropic (Claude). Informe a chave para o assistente funcionar: ela fica só no servidor.
# Sem a chave (ou se a IA falhar), o chat avisa que está indisponível e
# encaminha o visitante para o WhatsApp.
# ANTHROPIC_API_KEY=sk-ant-...
# (com a Anthropic, o modelo padrão é claude-haiku-5-5)
# CHAT_MODO=demonstracao        # só para testes sem chave: respostas prontas por palavras-chave
# Dados usados pelo chat:
# CHAT_EMPRESA_NOME=UmuFrio
# CHAT_WHATSAPP=44998049224     # só números, com DDD. Sem esta linha vale o número padrão (44) 99804-9224
# CHAT_HORARIO=Segunda a sexta, das 8h às 18h, e sábado, das 8h às 12h
# CHAT_CIDADE=Umuarama/PR
# CHAT_LIMITE_HORA=300          # teto de mensagens por hora (todas as pessoas)
