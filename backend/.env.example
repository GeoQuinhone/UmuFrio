DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/umufrio_db
SESSION_SECRET=troque-por-uma-chave-local-com-pelo-menos-32-caracteres
PORT=3001

# Copie este arquivo para .env e ajuste usuário, senha e banco conforme
# a instalação local do PostgreSQL.

# Opcional: se "true", só é possível concluir o atendimento com o pagamento confirmado.
# Por padrão (false) a tela apenas avisa que o pagamento está pendente.
EXIGIR_PAGAMENTO_PARA_CONCLUIR=false

# Produção: endereço(s) do frontend autorizados a chamar a API, separados por
# vírgula (ex.: https://umufrio.pages.dev). Deixe vazio no ambiente local.
CORS_ORIGIN=

# Em produção (Render), estas variáveis são preenchidas no painel do serviço,
# não neste arquivo. Veja DEPLOY.md na raiz do projeto.